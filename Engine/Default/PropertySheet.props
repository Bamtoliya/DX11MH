<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <ExtLib>$(SolutionDir)\External Libraries\</ExtLib>
  </PropertyGroup>
  <PropertyGroup>
    <ExternalIncludePath>$(SolutionDir)External Libraries\fmod\core\inc\;$(SolutionDir)External Libraries\fmod\fsbank\inc\;$(SolutionDir)External Libraries\fmod\studio\inc\;$(SolutionDir)External Libraries\imgui\;$(SolutionDir)External Libraries\ImGuizmo\;$(ExtLib)wwise\include;$(SolutionDir)External Libraries\imgui\backends;$(SolutionDir)External Libraries\tk\inc\;$(ExtLib)\fx11\inc\;$(ExtLib)\physx\include\;$(ExtLib)\assimp\;$(ExtLib)\;$(ExternalIncludePath)</ExternalIncludePath>
    <OutDir>../Bin</OutDir>
    <LibraryPath>$(SolutionDir)External Libraries\wwise\x64\$(Configuration)\lib\;$(SolutionDir)External Libraries\fmod\core\lib\x64\;$(SolutionDir)External Libraries\fmod\fsbank\lib\x64\;$(SolutionDir)External Libraries\fmod\studio\lib\x64\;$(SolutionDir)External Libraries\tk\lib\;$(ExtLib)\fx11\lib\;$(ExtLib)\assimp\lib\$(Configuration)\;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ExtLib)\physx\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>gameinput.lib;dinput8.lib;dxguid.lib;DirectXTK_Debug.lib;DirectXTK_Release.lib;PhysX_64.lib;PhysXGpu_64.lib;PhysXCooking_64.lib;PhysXCommon_64.lib;PhysXFoundation_64.lib;PhysXExtensions_static_64.lib;PhysXPvdSDK_static_64.lib;Effects11d.lib;Effects11.lib;assimp-vc143-mtd.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ExtLib)\fmod\core\lib\$(Platform)\;$(ExtLib)\fmod\fsbank\lib\$(Platform)\;$(ExtLib)\fmod\studio\lib\$(Platform)\;$(ExtLib)\wwise\$(Platform)\$(Configuration)\;$(ExtLib)\tk\lib\;$(ExtLib)\physx\bin\$(Configuration)\;$(ExtLib)\fx11\lib\;$(ExtLib)\assimp\lib\$(Configuration)\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="ExtLib">
      <Value>$(ExtLib)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>