<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <ExtLib>$(SolutionDir)\External Libraries\</ExtLib>
  </PropertyGroup>
  <PropertyGroup>
    <ExternalIncludePath>$(SolutionDir)External Libraries\fmod\core\inc\;$(SolutionDir)External Libraries\fmod\fsbank\inc\;$(SolutionDir)External Libraries\fmod\studio\inc\;$(SolutionDir)External Libraries\imgui\;$(SolutionDir)External Libraries\ImGuizmo\;$(ExtLib)wwise\include;$(SolutionDir)External Libraries\imgui\backends;$(ExternalIncludePath)</ExternalIncludePath>
    <OutDir>../Bin</OutDir>
    <LibraryPath>$(SolutionDir)External Libraries\wwise\x64\$(Configuration)\lib\;$(SolutionDir)External Libraries\fmod\core\lib\x64\;$(SolutionDir)External Libraries\fmod\fsbank\lib\x64\;$(SolutionDir)External Libraries\fmod\studio\lib\x64\;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <AdditionalDependencies>gameinput.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="ExtLib">
      <Value>$(ExtLib)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>